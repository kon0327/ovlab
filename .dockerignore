# Deny by default: production images receive only reviewed source and locks.
*

!code/
!code/apps/
!code/apps/benchctl/
!code/apps/benchctl/**
!code/apps/runner/
!code/apps/runner/**
!code/packages/
!code/packages/**
!code/policies/
!code/policies/**

!configs/
!configs/**
!experiments/
!experiments/**
experiments/**/.generated/
configs/local/*
!configs/local/profile.example.yaml

!deploy/
!deploy/config/
!deploy/config/**
!deploy/docker/
!deploy/docker/**
!deploy/locks/
!deploy/locks/**
!deploy/smoke/
!deploy/smoke/**
deploy/environments/
deploy/compose/
deploy/scripts/

# Registered source snapshots are staged below external/ before a build.
!external/
!external/**
external/.locks/
external/**/.ovlab-source.json

# Never send repository identity, test caches, assets, outputs, or secrets.
.git
**/.git
**/__pycache__
**/*.py[cod]
code/tests/
runs/
lab/reports/
checkpoints/
datasets/
docs/
notebooks/
.env
.env.*
*.pem
*.key
*credential*
*secret*
