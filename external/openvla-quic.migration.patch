+name: Standalone QuIC
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  core:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    strategy:
+      matrix:
+        python: ['3.10', '3.11']
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v7
+        with:
+          python-version: ${{ matrix.python }}
+          cache: pip
+      - run: python -m pip install torch==2.2.0 torchvision==0.17.0 --index-url https://download.pytorch.org/whl/cpu
+      - run: python -m pip install '.[dev,serve]'
+      - run: python -m pip check
+      - run: python -m unittest discover -s tests/quic -v
+      - run: openvla-quic --help
+      - run: python -m build && python -m twine check dist/*
+  rlds:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v7
+        with:
+          python-version: '3.10'
+          cache: pip
+      - run: python -m pip install torch==2.2.0 torchvision==0.17.0 --index-url https://download.pytorch.org/whl/cpu
+      - run: python -m pip install '.[rlds,dev]'
+      - run: python -m pip check
+      - run: python -m unittest discover -s tests/quic -p test_rlds.py -v
+        env:
+          OPENVLA_QUIC_TEST_RLDS: '1'
