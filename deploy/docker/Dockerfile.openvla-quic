# syntax=docker/dockerfile:1.7
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-devel@sha256:6353d21b66b5c00ae0f2683e447a0ba392157761f6dd0386a0dd648e0e5cc2de AS wheel-builder
ENV MAX_JOBS=4 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      git=1:2.34.1-1ubuntu1.17 ca-certificates=20260601~22.04.1 \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/locks/flash-attn.requirements.txt /tmp/flash-attn.requirements.txt
RUN python -m pip wheel --no-cache-dir --no-deps --no-build-isolation --require-hashes \
      -r /tmp/flash-attn.requirements.txt -w /wheelhouse \
    && python -m pip wheel --no-cache-dir --no-deps --no-build-isolation \
      'git+https://github.com/moojink/dlimp_openvla.git@040105d256bd28866cc6620621a3d5f7b6b91b46' -w /wheelhouse


FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime@sha256:e5c32997194edfc6fb0235223d1cd0433056045a468e7dfeaac390a3fcf8ae6d

# Keep the shared host dependency layers independent of source/build identity.
ENV OVLAB_ROOT=/opt/ovlab \
    OVLAB_LOCAL_PROFILE=/opt/ovlab/deploy/config/container-profile.yaml \
    OVLAB_POLICY_SOCKET=/run/ovlab/policy.sock \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=offline \
    HF_HOME=/tmp/ovlab-hf XDG_CACHE_HOME=/tmp/ovlab-cache \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/ovlab
COPY deploy/locks/quic-openvla.requirements.txt /tmp/requirements.txt
RUN rm -rf /opt/conda/lib/python3.10/site-packages/networkx /opt/conda/lib/python3.10/site-packages/networkx-*.dist-info \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY --from=wheel-builder /wheelhouse /wheelhouse
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation /wheelhouse/*.whl && rm -rf /wheelhouse
COPY code /opt/ovlab/code
COPY deploy/config /opt/ovlab/deploy/config
COPY deploy/docker/install-ovlab-packages.sh /tmp/install-ovlab-packages.sh
COPY external/openvla-quic /opt/ovlab/external/openvla-quic
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/ovlab/code/packages/quic-petf-vla \
    && bash /tmp/install-ovlab-packages.sh \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/ovlab/external/openvla-quic \
    && python -m pip check \
    && rm /tmp/install-ovlab-packages.sh \
    && groupadd --gid 10001 ovlab \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ovlab \
    && install -d -o 10001 -g 10001 -m 0700 /run/ovlab /var/lib/ovlab/training-run \
    && install -d -o root -g root -m 0755 /usr/share/ovlab \
    && python -m pip freeze --all > /usr/share/ovlab/pip-freeze-all.txt \
    && conda list --explicit > /usr/share/ovlab/conda-explicit-linux-64.txt

ARG OVLAB_REVISION
ARG OVLAB_SOURCE_MANIFEST_SHA256
ARG OVLAB_SOURCE_DIRTY
ARG OVLAB_LOCK_SHA256
ARG OVLAB_DOCKERFILE_SHA256
ARG OVLAB_IMAGE_REFERENCE=ovlab-policy-openvla-quic:local
ARG OVLAB_VERSION=0.2.0

LABEL org.opencontainers.image.title="OVLAB dense OpenVLA QuIC policy service" \
      org.opencontainers.image.source="https://github.com/kon0327/OpenVLABenchmark" \
      org.opencontainers.image.authors="Jiří Konečný, VSB - Technical University of Ostrava" \
      org.opencontainers.image.revision="$OVLAB_REVISION" \
      org.opencontainers.image.version="$OVLAB_VERSION" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.description="Dense token OpenVLA with adapter-only QuIC; benchmark-independent" \
      io.github.kon0327.ovlab.role="policy-openvla-quic" \
      io.github.kon0327.ovlab.build-target="production" \
      io.github.kon0327.ovlab.deployment.contract="resolved-checkpoint-quantization-config-bundle-v2" \
      io.github.kon0327.ovlab.python.version="3.10.13" \
      io.github.kon0327.ovlab.cuda.version="12.1" \
      io.github.kon0327.ovlab.runtime.components="torch=2.2.0;transformers=4.40.1;quic-petf-vla=0.1.0;flash-attn=2.5.5;tensorflow=2.15.0;tensorflow-metadata=1.17.2;protobuf=4.21.12" \
      io.github.kon0327.ovlab.source-manifest.sha256="$OVLAB_SOURCE_MANIFEST_SHA256" \
      io.github.kon0327.ovlab.source-dirty="$OVLAB_SOURCE_DIRTY" \
      io.github.kon0327.ovlab.dependency-lock.sha256="$OVLAB_LOCK_SHA256" \
      io.github.kon0327.ovlab.dockerfile.sha256="$OVLAB_DOCKERFILE_SHA256"

ENV OVLAB_IMAGE_ROLE=policy-openvla-quic \
    OVLAB_IMAGE_REFERENCE=$OVLAB_IMAGE_REFERENCE OVLAB_VERSION=$OVLAB_VERSION \
    OVLAB_REVISION=$OVLAB_REVISION OVLAB_BUILD_TARGET=production \
    OVLAB_PYTHON_VERSION=3.10.13 OVLAB_CUDA_RUNTIME_VERSION=12.1 \
    OVLAB_SOURCE_MANIFEST_SHA256=$OVLAB_SOURCE_MANIFEST_SHA256 OVLAB_SOURCE_DIRTY=$OVLAB_SOURCE_DIRTY \
    OVLAB_LOCK_SHA256=$OVLAB_LOCK_SHA256 OVLAB_DOCKERFILE_SHA256=$OVLAB_DOCKERFILE_SHA256

RUN --mount=type=secret,id=ovlab_source_manifest \
    test -s /run/secrets/ovlab_source_manifest \
    && cp /run/secrets/ovlab_source_manifest /usr/share/ovlab/source-manifest.json \
    && chmod 0444 /usr/share/ovlab/source-manifest.json

USER 10001:10001
ENTRYPOINT ["ovlab"]
CMD ["--help"]
