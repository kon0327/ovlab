# Copy to an untracked .env and replace only machine-local values.
OVLAB_BENCHMARK_IMAGE=ovlab-benchmark-libero:local
OVLAB_REPORTING_IMAGE=ovlab-reporting:local
OVLAB_OPENVLA_IMAGE=ovlab-policy-openvla:local
OVLAB_OFT_IMAGE=ovlab-policy-openvla-oft:local
OVLAB_BENCHMARK_IMAGE_DIGEST=unavailable
OVLAB_REPORTING_IMAGE_DIGEST=unavailable
OVLAB_OPENVLA_IMAGE_DIGEST=unavailable
OVLAB_OFT_IMAGE_DIGEST=unavailable
# Optional discovery roots. The CLI defaults to ~/.cache/huggingface and derives
# managed storage from OVLAB_RUNS_ROOT as ../checkpoints/huggingface.
# OVLAB_GLOBAL_HF_CACHE=/absolute/path/to/.cache/huggingface
# OVLAB_MANAGED_CHECKPOINTS_ROOT=../../../ovlab-data/checkpoints/huggingface
# Optional existing LIBERO dataset tree. If omitted, the CLI derives
# ../datasets/libero from OVLAB_RUNS_ROOT and creates it when needed.
# OVLAB_DATASETS_PATH=/absolute/path/to/libero
# Keep canonical evidence outside the source checkout. These paths are host
# deployment settings and do not affect the scientific configuration hash.
OVLAB_RUNS_ROOT=../../../ovlab-data/runs
OVLAB_DERIVED_ROOT=../../../ovlab-data/derived
OVLAB_EXPORTS_ROOT=../../../ovlab-data/exports
# Optional; reporting and export default to the repository's portable configs/ tree.
# OVLAB_CONFIGS_ROOT=../../configs
# Used only by the reporting profile.
OVLAB_REPORT_RUN_ID=replace-with-run-directory-name
OVLAB_REPORT_PROFILE=libero-task-default
OVLAB_REPORT_ENABLED=true
OVLAB_EXPORT_SPEC_PATH=../../configs/exports/libero-success-comparison.yaml
# Normally set automatically by `ovlab deploy run`.
OVLAB_EXPERIMENT_CONFIG=configs/experiments/libero10-lora-merged-rpc-smoke.yaml
OVLAB_GPU_DEVICE=0
OVLAB_EGL_DEVICE_ID=0
# Set automatically by `ovlab deploy run`; retained for direct Compose diagnostics.
OVLAB_HOST_ARTIFACT_GID=1000
# Used only with compose.glfw.yaml and an existing X11 server such as WSLg.
OVLAB_DISPLAY=:0
OVLAB_X11_SOCKET=/tmp/.X11-unix
OVLAB_DEPLOYMENT_MANIFEST_SHA256=unavailable
OVLAB_CONTAINER_RUNTIME_VERSION=unavailable
