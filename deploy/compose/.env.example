# Copy to an untracked .env and replace only machine-local values.
OVLAB_BENCHMARK_IMAGE=ovlab-benchmark-libero:local
OVLAB_OPENVLA_IMAGE=ovlab-policy-openvla:local
OVLAB_OFT_IMAGE=ovlab-policy-openvla-oft:local
OVLAB_BENCHMARK_IMAGE_DIGEST=unavailable
OVLAB_OPENVLA_IMAGE_DIGEST=unavailable
OVLAB_OFT_IMAGE_DIGEST=unavailable
OVLAB_CHECKPOINTS_PATH=../../checkpoints
OVLAB_DATASETS_PATH=../../datasets
# Keep canonical evidence outside the source checkout. These paths are host
# deployment settings and do not affect the scientific configuration hash.
OVLAB_RUNS_ROOT=../../../ovlab-data/runs
OVLAB_DERIVED_ROOT=../../../ovlab-data/derived
OVLAB_EXPORTS_ROOT=../../../ovlab-data/exports
# Used only by the reporting profile.
OVLAB_REPORT_RUN_ID=replace-with-run-directory-name
OVLAB_REPORT_OUTPUT_NAME=replace-with-derived-directory-name
OVLAB_GPU_DEVICE=0
OVLAB_EGL_DEVICE_ID=0
# Used only with compose.glfw.yaml and an existing X11 server such as WSLg.
OVLAB_DISPLAY=:0
OVLAB_X11_SOCKET=/tmp/.X11-unix
OVLAB_DEPLOYMENT_MANIFEST_SHA256=unavailable
OVLAB_CONTAINER_RUNTIME_VERSION=unavailable
