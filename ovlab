#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_paths=()
for source_path in "$repository_root"/code/packages/*/src "$repository_root"/code/policies/*/src "$repository_root"/code/apps/*/src "$repository_root"/external/quic-peft-vla/src; do
    if [[ -d "$source_path" ]]; then
        source_paths+=("$source_path")
    fi
done
joined_paths="$(IFS=:; echo "${source_paths[*]}")"
export PYTHONPATH="$joined_paths${PYTHONPATH:+:$PYTHONPATH}"
if [[ -n "${OVLAB_PYTHON:-}" ]]; then
    python_executable="$OVLAB_PYTHON"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]]; then
    python_executable="$VIRTUAL_ENV/bin/python"
elif [[ "${CONDA_DEFAULT_ENV:-}" == "ovlab-env" && -x "${CONDA_PREFIX:-}/bin/python" ]]; then
    python_executable="$CONDA_PREFIX/bin/python"
elif command -v conda >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    named_conda_prefix="$(conda env list --json 2>/dev/null | python3 -c 'import json, os, sys; data = json.load(sys.stdin); matches = [path for path in data.get("envs", []) if data.get("envs_details", {}).get(path, {}).get("name", os.path.basename(path)) == "ovlab-env"]; print(matches[0] if len(matches) == 1 else "")' 2>/dev/null)" || named_conda_prefix=""
    if [[ -x "$named_conda_prefix/bin/python" ]]; then
        python_executable="$named_conda_prefix/bin/python"
    elif [[ -f "$repository_root/.ovlab-env/pyvenv.cfg" && -x "$repository_root/.ovlab-env/bin/python" ]]; then
        python_executable="$repository_root/.ovlab-env/bin/python"
    else
        python_executable=python3
    fi
elif [[ -f "$repository_root/.ovlab-env/pyvenv.cfg" && -x "$repository_root/.ovlab-env/bin/python" ]]; then
    python_executable="$repository_root/.ovlab-env/bin/python"
else
    python_executable=python3
fi
if ! command -v "$python_executable" >/dev/null 2>&1; then
    echo "OVLAB requires Python 3 for its host-side CLI launcher." >&2
    exit 127
fi

# Translate canonical host paths when reporting runs inside its data mount.
_ovlab_translate_run_paths() {
    local host_root="$1" index argument prefix value
    local -n command_args="$2"
    for ((index=0; index<${#command_args[@]}; index++)); do
        argument="${command_args[$index]}"
        prefix=""
        value="$argument"
        if [[ "$argument" == --*=/* ]]; then
            prefix="${argument%%=*}="
            value="${argument#*=}"
        fi
        if [[ "$value" == "$host_root/"* ]]; then
            command_args[$index]="${prefix}/var/lib/ovlab/runs/${value#"$host_root/"}"
        fi
    done
}

# Dataset mutation is always isolated from checkpoints, benchmark runs, and
# reporting. Only the explicit `dataset fetch` command receives network access.
if [[ "${1:-}" == "dataset" && "${OVLAB_DATASET_RUNTIME:-docker}" != "host" ]]; then
    if ! command -v docker >/dev/null 2>&1; then
        echo "ovlab: dataset operations require Docker; the Docker CLI is unavailable." >&2
        exit 127
    fi
    model_data_root="${OVLAB_MODEL_DATA_ROOT:-${OVLAB_DATA_ROOT:-$repository_root/../ovlab-data}}"
    model_data_root="$(realpath -m -- "$model_data_root")"
    datasets_root="$model_data_root/datasets"
    dataset_image="${OVLAB_DATASET_IMAGE:-ovlab-dataset:local}"
    if ! docker image inspect "$dataset_image" >/dev/null 2>&1; then
        echo "ovlab: dataset image is unavailable: $dataset_image" >&2
        echo "ovlab: build it with: bash deploy/scripts/build-images.sh dataset" >&2
        exit 6
    fi
    dataset_command="${2:-}"
    help_requested=false
    for argument in "$@"; do
        if [[ "$argument" == "--help" || "$argument" == "-h" ]]; then
            help_requested=true
            break
        fi
    done
    mount_dataset=false
    writable_dataset=false
    require_dataset=false
    network="none"
    case "$dataset_command" in
        fetch) mount_dataset=true; writable_dataset=true; network="bridge" ;;
        import) mount_dataset=true; writable_dataset=true ;;
        prepare|inspect|verify) mount_dataset=true; require_dataset=true ;;
        list) mount_dataset=true ;;
        providers|resolve|--help|-h) ;;
        *) echo "ovlab: unsupported dataset command: $dataset_command" >&2; exit 2 ;;
    esac
    if [[ "$help_requested" == "true" ]]; then
        mount_dataset=false
        writable_dataset=false
        require_dataset=false
        network="none"
    fi
    args=("$@")
    import_mount=()
    dataset_source=""
    dataset_name=""
    if [[ "$writable_dataset" == "true" ]]; then
        mkdir -p -- "$datasets_root"
        chmod 2770 -- "$datasets_root"
    fi
    dataset_target_index=-1
    dataset_path_index=-1
    dataset_path_equals=false
    if [[ "$help_requested" == "false" && ( "$dataset_command" == "fetch" || "$dataset_command" == "import" ) ]]; then
        [[ "$dataset_command" == "import" ]] && dataset_source="local"
        for ((index=2; index<${#args[@]}; index++)); do
            argument="${args[$index]}"
            case "$argument" in
                --source|--name|--path|--version|--url|--sha256|--archive|--format)
                    if (( index + 1 < ${#args[@]} )); then
                        index=$((index + 1))
                        case "$argument" in
                            --source) dataset_source="${args[$index]}" ;;
                            --name) dataset_name="${args[$index]}" ;;
                            --path) dataset_path_index=$index ;;
                        esac
                    fi ;;
                --source=*) dataset_source="${argument#--source=}" ;;
                --name=*) dataset_name="${argument#--name=}" ;;
                --path=*) dataset_path_index=$index; dataset_path_equals=true ;;
                --*) ;;
                *)
                    if (( dataset_target_index >= 0 )); then
                        echo "ovlab: dataset $dataset_command accepts one positional target." >&2
                        exit 2
                    fi
                    dataset_target_index=$index ;;
            esac
        done
        if (( dataset_target_index >= 0 )); then
            if [[ "$dataset_command" == "fetch" ]]; then
                if [[ -n "$dataset_name" ]]; then
                    echo "ovlab: dataset fetch accepts NAME or --name, not both." >&2
                    exit 2
                fi
                dataset_name="${args[$dataset_target_index]}"
            else
                if (( dataset_path_index >= 0 )); then
                    echo "ovlab: dataset import accepts PATH or --path, not both." >&2
                    exit 2
                fi
                dataset_path_index=$dataset_target_index
            fi
        fi
    fi
    if [[ -n "$dataset_source" || -n "$dataset_name" ]]; then
        if [[ ! "$dataset_source" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || ! "$dataset_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            echo "ovlab: dataset source and name must be path-safe identifiers." >&2
            exit 3
        fi
        provider_root="$datasets_root/$dataset_source"
        name_root="$provider_root/$dataset_name"
        if [[ -L "$provider_root" || -L "$name_root" ]]; then
            echo "ovlab: dataset publication path must not contain symbolic links." >&2
            exit 3
        fi
        mkdir -p -- "$provider_root" "$name_root"
        chmod 2770 -- "$provider_root" "$name_root"
    fi
    if [[ "$dataset_command" == "import" && "$help_requested" == "false" ]]; then
        source_path=""
        if (( dataset_path_index >= 0 )); then
            source_path="${args[$dataset_path_index]}"
            [[ "$dataset_path_equals" == true ]] && source_path="${source_path#--path=}"
            source_path="$(realpath -- "$source_path")"
            if [[ "$dataset_path_equals" == true ]]; then
                args[$dataset_path_index]="--path=/imports/source"
            else
                args[$dataset_path_index]="/imports/source"
            fi
        fi
        if [[ -z "$source_path" || ! -d "$source_path" ]]; then
            echo "ovlab: dataset import --path must name an existing directory." >&2
            exit 3
        fi
        import_mount=(--mount "type=bind,source=$source_path,target=/imports/source,readonly")
    fi
    dataset_mount=()
    if [[ "$mount_dataset" == "true" && -d "$datasets_root" ]]; then
        dataset_mount_spec="type=bind,source=$datasets_root,target=/var/lib/ovlab/model-data/datasets"
        if [[ "$writable_dataset" != "true" ]]; then
            dataset_mount_spec+=",readonly"
        fi
        dataset_mount=(--mount "$dataset_mount_spec")
    elif [[ "$require_dataset" == "true" ]]; then
        echo "ovlab: dataset registry does not exist: $datasets_root" >&2
        exit 4
    fi
    # Docker runs without a TTY, so pass the caller's terminal width explicitly.
    dataset_columns="${COLUMNS:-}"
    if [[ -t 1 ]] && command -v stty >/dev/null 2>&1; then
        terminal_size="$(stty size <&1 2>/dev/null || true)"
        [[ "$terminal_size" =~ ^[0-9]+[[:space:]]+([0-9]+)$ ]] && dataset_columns="${BASH_REMATCH[1]}"
    fi
    dataset_terminal_env=()
    if [[ "$dataset_columns" =~ ^[1-9][0-9]*$ ]]; then
        dataset_terminal_env=(--env "COLUMNS=$dataset_columns")
    fi
    echo "ovlab: dataset: using isolated image $dataset_image (network=$network)." >&2
    dataset_docker=(docker run --rm
        --network "$network" --read-only --user 10001:10001 --group-add "$(id -g)"
        --cap-drop ALL --security-opt no-new-privileges:true
        --tmpfs /tmp:rw,nosuid,nodev,size=2g,uid=10001,gid=10001,mode=0700
        --env OVLAB_MODEL_DATA_ROOT=/var/lib/ovlab/model-data
        --env "OVLAB_MODEL_DATA_DISPLAY_ROOT=$model_data_root"
        "${dataset_terminal_env[@]}" "${dataset_mount[@]}" "${import_mount[@]}"
        "$dataset_image")
    # Format list output with the checkout's CLI, even if the isolated image
    # was built before the current human-readable formatting was introduced.
    if [[ "$dataset_command" == "list" && "$help_requested" == false ]]; then
        dataset_structured=false
        for argument in "${args[@]}"; do
            [[ "$argument" == "--json" || "$argument" == "--detail" ]] && dataset_structured=true
        done
        if [[ "$dataset_structured" == false ]]; then
            set +e
            "${dataset_docker[@]}" "${args[@]}" --json | "$python_executable" -c '
import json, sys
from ovlab_benchctl.cli import _human, _compact
try:
    doc = json.load(sys.stdin)
except (ValueError, OSError):
    sys.exit(1)
if doc.get("status") != "success":
    for error in doc.get("errors", []):
        print("ovlab: " + error.get("message", "dataset list failed"), file=sys.stderr)
    sys.exit(1)
_human(_compact("dataset list", doc.get("result")))
'
            dataset_pipeline_status=("${PIPESTATUS[@]}")
            set -e
            if (( dataset_pipeline_status[0] != 0 )); then
                exit "${dataset_pipeline_status[0]}"
            fi
            exit "${dataset_pipeline_status[1]}"
        fi
    fi
    exec "${dataset_docker[@]}" "${args[@]}"
fi

# Training performance reports use the same purpose-built reporting image while
# reading canonical training evidence through a separate read-only mount.
if [[ ( "${1:-}" == "train" && "${2:-}" == "report" && "${3:-}" != "--help" && "${3:-}" != "-h" ) || ( "${1:-}" == "run" && "${2:-}" == "train" && "${3:-}" == "report" && "${4:-}" != "--help" && "${4:-}" != "-h" ) ]]; then
    [[ "${1:-}" == "run" ]] && set -- "${@:2}"
    reporting_runtime="${OVLAB_REPORTING_RUNTIME:-docker}"
    if [[ "$reporting_runtime" != "host" ]]; then
        if ! command -v docker >/dev/null 2>&1; then
            echo "ovlab: training reports require Docker; the Docker CLI is unavailable." >&2
            exit 127
        fi
        data_root="${OVLAB_DATA_ROOT:-$repository_root/../ovlab-data}"
        model_data_root="${OVLAB_MODEL_DATA_ROOT:-$data_root}"
        runs_root="$(realpath -m -- "${OVLAB_RUNS_ROOT:-$model_data_root/runs}")"
        training_runs_root="$(realpath -m -- "$model_data_root/training-runs")"
        exports_root="$(realpath -m -- "${OVLAB_EXPORTS_ROOT:-$model_data_root/exports}")"
        derived_root="$exports_root/train/derived"
        if [[ ! -d "$runs_root" && ! -d "$training_runs_root" ]]; then
            echo "ovlab: training run directories do not exist: $runs_root or $training_runs_root" >&2
            exit 4
        fi
        training_report_mounts=()
        training_report_roots=()
        training_report_args=("$@")
        _ovlab_translate_run_paths "$runs_root" training_report_args
        parameter_mount_added=false
        for ((index=0; index<${#training_report_args[@]}; index++)); do
            parameter_index=-1
            parameter_equals=false
            if [[ "${training_report_args[$index]}" == "--parameters" && $((index + 1)) -lt ${#training_report_args[@]} ]]; then
                parameter_index=$((index + 1))
                parameter_path="${training_report_args[$parameter_index]}"
            elif [[ "${training_report_args[$index]}" == --parameters=* ]]; then
                parameter_index=$index
                parameter_equals=true
                parameter_path="${training_report_args[$index]#--parameters=}"
            fi
            if (( parameter_index >= 0 )); then
                configs_root="$(realpath -m -- "${OVLAB_CONFIGS_ROOT:-$repository_root/configs}")"
                [[ "$parameter_path" == /* ]] || parameter_path="$repository_root/$parameter_path"
                parameter_path="$(realpath -e -- "$parameter_path")" || exit 3
                if [[ ! -f "$parameter_path" || "$parameter_path" != "$configs_root/"* ]]; then
                    echo "ovlab: training report --parameters must name a JSON file within $configs_root." >&2
                    exit 3
                fi
                parameter_path="/opt/ovlab/configs/${parameter_path#"$configs_root/"}"
                if [[ "$parameter_equals" == true ]]; then
                    training_report_args[$parameter_index]="--parameters=$parameter_path"
                else
                    training_report_args[$parameter_index]="$parameter_path"
                fi
                if [[ "$parameter_mount_added" == false ]]; then
                    training_report_mounts+=(--mount "type=bind,source=$configs_root,target=/opt/ovlab/configs,readonly")
                    parameter_mount_added=true
                fi
            fi
        done
        if [[ -d "$runs_root" ]]; then
            training_report_mounts+=(--mount "type=bind,source=$runs_root,target=/var/lib/ovlab/runs,readonly")
            training_report_roots+=("$runs_root")
            [[ -d "$runs_root/train" ]] && training_report_roots+=("$runs_root/train")
        fi
        if [[ -d "$training_runs_root" ]]; then
            training_report_mounts+=(--mount "type=bind,source=$training_runs_root,target=/var/lib/ovlab/model-data/training-runs,readonly")
            training_report_roots+=("$training_runs_root")
        fi
        reporting_image="${OVLAB_REPORTING_IMAGE:-ovlab-reporting:local}"
        if ! docker image inspect "$reporting_image" >/dev/null 2>&1; then
            echo "ovlab: reporting image is unavailable: $reporting_image" >&2
            echo "ovlab: build it with: bash deploy/scripts/build-images.sh reporting" >&2
            exit 6
        fi
        training_report_verify="false"
        for argument in "$@"; do
            [[ "$argument" == "--verify" ]] && training_report_verify="true"
        done
        if [[ "$training_report_verify" == "true" ]]; then
            if [[ ! -d "$exports_root" ]]; then
                echo "ovlab: report export directory does not exist: $exports_root" >&2
                exit 4
            fi
            exports_mount="type=bind,source=$exports_root,target=/var/lib/ovlab/exports,readonly"
        else
            if [[ -z "${OVLAB_EXPERIMENT_ID:-}" ]]; then
                mkdir -p -- "$derived_root" "$exports_root/train/interactive"
                chmod 2770 -- "$exports_root" "$exports_root/train" "$derived_root" "$exports_root/train/interactive"
            else
                mkdir -p -- "$exports_root"
                chmod 2770 -- "$exports_root"
            fi
            exports_mount="type=bind,source=$exports_root,target=/var/lib/ovlab/exports"
        fi
        declare -A training_report_groups=(["$(id -g)"]=1)
        for report_root in "${training_report_roots[@]}" "$exports_root" "$exports_root/train" "$derived_root" "$exports_root/train/interactive" "$exports_root/interactive"; do
            if [[ -d "$report_root" ]]; then
                training_report_groups["$(stat -c %g -- "$report_root")"]=1
            fi
        done
        training_report_group_args=()
        for report_group in "${!training_report_groups[@]}"; do
            training_report_group_args+=(--group-add "$report_group")
        done
        echo "ovlab: reporting: using isolated image $reporting_image for training performance." >&2
        exec docker run --rm \
            --network none --read-only --user 10001:10001 "${training_report_group_args[@]}" \
            --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=0700 \
            --env OVLAB_MODEL_DATA_ROOT=/var/lib/ovlab/model-data \
            --env OVLAB_RUNS_ROOT=/var/lib/ovlab/runs \
            --env OVLAB_EXPORTS_ROOT=/var/lib/ovlab/exports \
            --env OVLAB_ARTIFACT_UMASK=0007 \
            --env "OVLAB_EXPERIMENT_ID=${OVLAB_EXPERIMENT_ID:-}" \
            --env "OVLAB_EXPERIMENT_NODE=${OVLAB_EXPERIMENT_NODE:-}" \
            --env "OVLAB_DERIVED_DISPLAY_ROOT=$derived_root" \
            --env "OVLAB_EXPORTS_DISPLAY_ROOT=$exports_root" \
            "${training_report_mounts[@]}" \
            --mount "$exports_mount" \
            "$reporting_image" "${training_report_args[@]}"
    fi
fi

# Render help from the checkout, including the unified report interface.
if [[ "${1:-}" == "report" && "${2:-}" == "generate" ]]; then
    exec "$python_executable" -m ovlab_benchctl.cli "$@"
fi
if [[ "${1:-}" == "report" ]]; then
    for argument in "$@"; do
        if [[ "$argument" == "--help" || "$argument" == "-h" ]]; then
            exec "$python_executable" -m ovlab_benchctl.cli "$@"
        fi
    done
fi

# Present report and export through one command while keeping older container
# images compatible with their existing `report publish` and `export` entry points.
if [[ "${1:-}" == "report" && "${2:-}" != "" ]]; then
    if [[ "${2:-}" == "auto" || ( "${2:-}" != -* && "${2:-}" != "generate" && "${2:-}" != "publish" && "${2:-}" != "verify" && "${2:-}" != "profiles" && "${2:-}" != "export" ) ]]; then
        # Selection runs on the host; each export still runs in the isolated image.
        exec "$python_executable" -m ovlab_benchctl.cli "$@"
    fi
fi

# Reporting and export use their purpose-built image by default. Host execution
# remains an explicit diagnostic escape hatch, never an implicit Conda dependency.
if [[ "${1:-}" == "report" || "${1:-}" == "export" ]]; then
    reporting_runtime="${OVLAB_REPORTING_RUNTIME:-${OVLAB_EXPORT_RUNTIME:-docker}}"
    if [[ "$reporting_runtime" != "host" ]]; then
        if ! command -v docker >/dev/null 2>&1; then
            echo "ovlab: reporting requires Docker; the Docker CLI is unavailable." >&2
            echo "ovlab: set OVLAB_REPORTING_RUNTIME=host only for an explicitly prepared host Python." >&2
            exit 127
        fi
        data_root="${OVLAB_DATA_ROOT:-$repository_root/../ovlab-data}"
        runs_root="${OVLAB_RUNS_ROOT:-$data_root/runs}"
        exports_root="${OVLAB_EXPORTS_ROOT:-$data_root/exports}"
        configs_root="${OVLAB_CONFIGS_ROOT:-$repository_root/configs}"
        runs_root="$(realpath -m -- "$runs_root")"
        exports_root="$(realpath -m -- "$exports_root")"
        derived_root="$exports_root/evaluate/derived"
        configs_root="$(realpath -m -- "$configs_root")"
        reporting_args=("$@")
        _ovlab_translate_run_paths "$runs_root" reporting_args
        if [[ "${1:-}" == "report" && "${2:-}" == "publish" ]]; then
            for ((index=2; index<${#reporting_args[@]}; index++)); do
                output_index=-1
                output_prefix=""
                case "${reporting_args[$index]}" in
                    --output)
                        if (( index + 1 < ${#reporting_args[@]} )); then
                            output_index=$((index + 1))
                            output_path="${reporting_args[$output_index]}"
                        fi ;;
                    --output=*)
                        output_index=$index
                        output_prefix="--output="
                        output_path="${reporting_args[$index]#--output=}" ;;
                esac
                if (( output_index >= 0 )); then
                    output_path="$(realpath -m -- "$output_path")"
                    if [[ "$output_path" != "$exports_root/"* ]]; then
                        echo "ovlab: report --output must be inside $exports_root when using Docker." >&2
                        exit 3
                    fi
                    reporting_args[$output_index]="${output_prefix}/var/lib/ovlab/exports/${output_path#"$exports_root/"}"
                fi
            done
        fi
        if [[ "${1:-}" != "report" || "${2:-}" != "profiles" ]] && [[ ! -d "$runs_root" ]]; then
            echo "ovlab: canonical run source directory does not exist: $runs_root" >&2
            exit 4
        fi
        if [[ ! -d "$configs_root" ]]; then
            echo "ovlab: portable config directory does not exist: $configs_root" >&2
            exit 3
        fi
        reporting_image="${OVLAB_REPORTING_IMAGE:-ovlab-reporting:local}"
        if ! docker image inspect "$reporting_image" >/dev/null 2>&1; then
            echo "ovlab: reporting image is unavailable: $reporting_image" >&2
            echo "ovlab: build it with: bash deploy/scripts/build-images.sh reporting" >&2
            exit 6
        fi
        if [[ "${1:-}" == "report" && "${2:-}" == "profiles" ]]; then
            echo "ovlab: reporting: using isolated image $reporting_image (read-only registry)." >&2
            exec docker run --rm \
                --network none \
                --read-only \
                --user 10001:10001 \
                --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m,uid=10001,gid=10001,mode=0700 \
                "$reporting_image" "${reporting_args[@]}"
        fi
        verification_kind=""
        if [[ "${1:-}" == "report" && "${2:-}" == "verify" ]]; then
            verification_kind="report"
        elif [[ "${1:-}" == "export" && "${2:-}" == "verify" ]]; then
            verification_kind="export"
        fi
        if [[ -n "$verification_kind" ]]; then
            verification_mounts=(
                --mount "type=bind,source=$configs_root,target=/opt/ovlab/configs,readonly"
                --mount "type=bind,source=$runs_root,target=/var/lib/ovlab/runs,readonly"
            )
            if [[ "$verification_kind" == "report" ]]; then
                if [[ ! -d "$exports_root" ]]; then
                    echo "ovlab: report export directory does not exist: $exports_root" >&2
                    exit 4
                fi
                verification_mounts+=(
                    --mount "type=bind,source=$exports_root,target=/var/lib/ovlab/exports,readonly"
                )
            else
                if [[ ! -d "$exports_root" ]]; then
                    echo "ovlab: export directory does not exist: $exports_root" >&2
                    exit 4
                fi
                verification_mounts+=(
                    --mount "type=bind,source=$exports_root,target=/var/lib/ovlab/exports,readonly"
                )
            fi
            echo "ovlab: reporting: using isolated image $reporting_image (read-only $verification_kind verification)." >&2
            exec docker run --rm \
                --network none \
                --read-only \
                --user 10001:10001 \
                --group-add "$(id -g)" \
                --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=0700 \
                --env OVLAB_RUNS_ROOT=/var/lib/ovlab/runs \
                --env OVLAB_EXPORTS_ROOT=/var/lib/ovlab/exports \
                --env OVLAB_ARTIFACT_UMASK=0007 \
                --env "OVLAB_EXPERIMENT_ID=${OVLAB_EXPERIMENT_ID:-}" \
                --env "OVLAB_EXPERIMENT_NODE=${OVLAB_EXPERIMENT_NODE:-}" \
                --env "OVLAB_DERIVED_DISPLAY_ROOT=$derived_root" \
                --env "OVLAB_EXPORTS_DISPLAY_ROOT=$exports_root" \
                "${verification_mounts[@]}" \
                "$reporting_image" "${reporting_args[@]}"
        fi
        mkdir -p -- "$runs_root" "$exports_root"
        if [[ -z "${OVLAB_EXPERIMENT_ID:-}" ]]; then
            mkdir -p -- "$exports_root/evaluate/derived" "$exports_root/evaluate/interactive" "$exports_root/evaluate/isolated" "$exports_root/evaluate/grouped"
            reporting_output_roots=("$exports_root" "$exports_root/evaluate" "$exports_root/evaluate/derived" "$exports_root/evaluate/interactive" "$exports_root/evaluate/isolated" "$exports_root/evaluate/grouped")
        else
            reporting_output_roots=("$exports_root")
        fi
        if ! chmod 2770 -- "${reporting_output_roots[@]}"; then
            echo "ovlab: cannot establish group-writable reporting output directories." >&2
            exit 6
        fi
        echo "ovlab: reporting: using isolated image $reporting_image." >&2
        exec docker run --rm \
            --network none \
            --read-only \
            --user 10001:10001 \
            --group-add "$(id -g)" \
            --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=0700 \
            --env OVLAB_RUNS_ROOT=/var/lib/ovlab/runs \
            --env OVLAB_EXPORTS_ROOT=/var/lib/ovlab/exports \
            --env OVLAB_ARTIFACT_UMASK=0007 \
            --env "OVLAB_EXPERIMENT_ID=${OVLAB_EXPERIMENT_ID:-}" \
            --env "OVLAB_EXPERIMENT_NODE=${OVLAB_EXPERIMENT_NODE:-}" \
            --env "OVLAB_DERIVED_DISPLAY_ROOT=$derived_root" \
            --env "OVLAB_EXPORTS_DISPLAY_ROOT=$exports_root" \
            --mount "type=bind,source=$configs_root,target=/opt/ovlab/configs,readonly" \
            --mount "type=bind,source=$runs_root,target=/var/lib/ovlab/runs,readonly" \
            --mount "type=bind,source=$exports_root,target=/var/lib/ovlab/exports" \
            "$reporting_image" "${reporting_args[@]}"
    fi
fi
exec "$python_executable" -m ovlab_benchctl.cli "$@"
