{
  "schema_version": "ovlab.extension/v1",
  "id": "example-policy",
  "category": "plugin",
  "version": "2.0.0",
  "description": "CPU constant policy with a native two-joint action boundary.",
  "sources": {},
  "providers": {
    "constant": {
      "kind": "policy",
      "api_version": "2",
      "id": "example-policy",
      "config_type": "example_policy",
      "family": "example",
      "runtime_status": "experimental",
      "entrypoint": "example_policy.plugin:plugin",
      "sources": [],
      "deployment": {
        "profile": "example",
        "role": "policy-example",
        "image": "ovlab-policy-example:local",
        "image_env": "OVLAB_EXAMPLE_IMAGE",
        "policy_service": "policy-example",
        "quantization": ["none"],
        "gpu": false
      }
    }
  },
  "builds": {
    "policy-example": {
      "dockerfile": "Dockerfile",
      "image": "ovlab-policy-example:local",
      "sources": [],
      "locks": []
    }
  },
  "configs": {
    "root": "configs",
    "checkpoints": ["resources.yaml"],
    "templates": {"policy": ["policy.yaml"], "deploy": ["deployment.yaml"]}
  },
  "capabilities": {
    "inputs": [],
    "action_interface": "example-planar-joint-delta-v1",
    "quantization": ["none"],
    "devices": ["cpu"]
  }
}
