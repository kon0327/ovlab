# Optional repo-local experiment output
runs/*
lab/reports/*
deploy/compose/images.local.env

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.ovlab-env/
venv/
env/
ENV/

# Test, type, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/

# Local environment files
.env
.env.*
!.env.example
# User configuration and experiment recipes are local workspace content.
# Public defaults live in config/ and plugin projects; examples live in examples/.
/configs/**
!/configs/README.md
/experiments/**
!/experiments/README.md

# Materialized plugin sources and generated Compose plans
/external/
/plugins/.cache/
/deploy/compose/.ovlab-*.json
