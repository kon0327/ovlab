{
  "schema_version": "ovlab.extension/v1",
  "version": "0.2.0",
  "id": "openvla-quic",
  "description": "OpenVLA-QuIC policy and adapter training integration for OVLAB.",
  "sources": {
    "openvla-quic": {
      "kind": "git",
      "url": "https://github.com/kon0327/openvla-quic.git",
      "commit": "cca67fab79646363fa98b7d96e6216dcee11fcc6",
      "path": "external/openvla-quic"
    },
    "quic-peft-vla": {
      "kind": "git",
      "url": "https://github.com/kon0327/quic-peft-vla.git",
      "commit": "e727b31c2e4e160c29c0dbe865be093bdd65e5e2",
      "path": "external/quic-peft-vla"
    },
    "openvla-support": {
      "kind": "local",
      "path": "../_shared/openvla-support"
    }
  },
  "builds": {
    "policy-openvla-quic": {
      "dockerfile": "docker/Dockerfile.openvla-quic",
      "image": "ovlab-policy-openvla-quic:local",
      "sources": [
        "openvla-quic",
        "quic-peft-vla",
        "openvla-support"
      ],
      "locks": [
        "locks/quic-openvla.pylock.toml",
        "locks/quic-openvla.requirements.txt",
        "locks/flash-attn.pylock.toml",
        "locks/flash-attn.requirements.txt"
      ]
    },
    "training-openvla-quic": {
      "dockerfile": "docker/Dockerfile.training-openvla-quic",
      "image": "ovlab-training-openvla-quic:local",
      "sources": [
        "openvla-quic",
        "quic-peft-vla",
        "openvla-support"
      ],
      "locks": [
        "locks/quic-openvla.pylock.toml",
        "locks/quic-openvla.requirements.txt",
        "locks/flash-attn.pylock.toml",
        "locks/flash-attn.requirements.txt"
      ]
    },
    "finalizer-openvla-quic": {
      "dockerfile": "docker/Dockerfile.finalizer",
      "image": "ovlab-finalizer-openvla-quic:local",
      "sources": [
        "openvla-support"
      ],
      "locks": [
        "locks/finalizer.pylock.toml",
        "locks/finalizer.requirements.txt"
      ]
    }
  },
  "configs": {
    "root": "configs",
    "checkpoints": [
      "registry/default.yaml"
    ],
    "templates": {
      "evaluate": [
        "evaluate/default.yaml"
      ],
      "train": [
        "train/default.yaml"
      ]
    }
  },
  "capabilities": {
    "policy": {
      "supported": true
    },
    "training": {
      "supported": true
    }
  },
  "category": "plugin",
  "providers": {
    "quic-peft": {
      "kind": "policy",
      "api_version": "2",
      "config_type": "openvla_quic",
      "id": "quic-peft",
      "family": "openvla_quic",
      "runtime_status": "experimental",
      "entrypoint": "ovlab_openvla_quic.plugin:plugin",
      "sources": [
        "openvla-quic",
        "quic-peft-vla",
        "openvla-support"
      ],
      "source_repositories": [
        "external/openvla-quic",
        "external/quic-peft-vla"
      ],
      "deployment": {
        "profile": "quic",
        "role": "policy-openvla-quic",
        "image": "ovlab-policy-openvla-quic:local",
        "image_env": "OVLAB_QUIC_IMAGE",
        "policy_service": "policy-openvla-quic",
        "quantization": [
          "none"
        ]
      },
      "document_kinds": [
        "quic_policy_descriptor"
      ],
      "supported_quic_profiles": [
        "QP1",
        "QP2",
        "QP3",
        "QP4",
        "custom"
      ],
      "supported_profiles": [
        "QP1",
        "QP2",
        "QP3",
        "QP4",
        "custom"
      ],
      "capabilities": {
        "observation": {
          "images": {
            "encoding": "raw",
            "color_space": "RGB",
            "dtype": "uint8",
            "roles": [
              "primary"
            ]
          },
          "proprioception": {
            "required": false
          },
          "instruction": {
            "required": true,
            "dynamic": true
          }
        },
        "action": {
          "dimension": 7,
          "representation": "delta_pose",
          "rotation_representation": "axis_angle",
          "gripper_convention": "closed_positive",
          "codecs": [
            "openvla-to-libero-v1",
            "openvla-decoded-v1"
          ],
          "prediction_horizon": {
            "minimum": 1,
            "maximum": 256,
            "configurable": true
          }
        },
        "inference": {
          "quantization": {
            "none": {
              "backend": null,
              "weight_dtype": "bfloat16",
              "training_supported": true
            }
          },
          "policy_configs": {
            "none": "plugin://openvla-quic/policy/default.yaml"
          }
        },
        "checkpoints": {
          "expected_loaders": [
            "ovlab-openvla-quic"
          ],
          "artifact_forms": [
            "multiplicative_adapter"
          ],
          "requires_base_model": true
        },
        "training": {
          "supported": true,
          "implementations": [
            "openvla-quic"
          ],
          "methods": [
            "quic"
          ],
          "quantization": [
            "none"
          ],
          "status": "experimental"
        },
        "checkpoint_binding": {
          "training_methods": [
            "quic"
          ],
          "match_training_normalization": true,
          "adapter_identity": {
            "settings_path": "quic",
            "path": "adapter_path",
            "hashes": [
              "adapter_manifest_sha256",
              "adapter_tensor_sha256"
            ]
          }
        }
      },
      "control_sources": [
        "openvla-support"
      ],
      "artifact_forms": [
        "merged_full_weights",
        "multiplicative_adapter"
      ],
      "training": {
        "entrypoint": "ovlab_openvla_training.plugin:plugin",
        "implementations": [
          "openvla-quic"
        ],
        "expected_loaders": [
          "ovlab-openvla-quic"
        ],
        "images": {
          "openvla-quic": {
            "role": "training-openvla-quic",
            "image": "ovlab-training-openvla-quic:local",
            "image_env": "OVLAB_TRAINING_QUIC_IMAGE"
          }
        },
        "modules": {
          "training_runs": "ovlab_openvla_training.training_runs",
          "training_data": "ovlab_openvla_training.training_data",
          "training_evidence": "ovlab_openvla_training.training_evidence",
          "training_quic": "ovlab_openvla_training.training_quic",
          "quic_experiments": "ovlab_openvla_training.quic_experiments",
          "checkpoint_preparation": "ovlab_openvla_training.checkpoint_preparation",
          "workflow_checkpoints": "ovlab_openvla_training.workflow_checkpoints"
        },
        "finalizer": {
          "role": "finalizer-openvla-quic",
          "image": "ovlab-finalizer-openvla-quic:local",
          "image_env": "OVLAB_FINALIZER_QUIC_IMAGE"
        }
      }
    }
  }
}
