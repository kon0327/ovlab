{
  "schema_version": "ovlab.extension/v1",
  "version": "0.2.0",
  "id": "openvla",
  "description": "OpenVLA policy, full and LoRA training integration for OVLAB.",
  "sources": {
    "openvla": {
      "kind": "git",
      "url": "https://github.com/openvla/openvla.git",
      "commit": "c8f03f48af692657d3060c19588038c7220e9af9",
      "path": "external/openvla"
    },
    "openvla-support": {
      "kind": "local",
      "path": "../_shared/openvla-support"
    }
  },
  "builds": {
    "policy-openvla": {
      "dockerfile": "docker/Dockerfile.openvla",
      "image": "ovlab-policy-openvla:local",
      "sources": [
        "openvla",
        "openvla-support"
      ],
      "locks": [
        "locks/openvla.pylock.toml",
        "locks/openvla.requirements.txt",
        "locks/flash-attn.pylock.toml",
        "locks/flash-attn.requirements.txt"
      ]
    },
    "training-openvla": {
      "dockerfile": "docker/Dockerfile.training-openvla",
      "image": "ovlab-training-openvla:local",
      "sources": [
        "openvla",
        "openvla-support"
      ],
      "locks": [
        "locks/training-runtime-base.pylock.toml",
        "locks/training-runtime-base.requirements.txt",
        "locks/training-openvla.pylock.toml",
        "locks/training-openvla.requirements.txt",
        "locks/flash-attn.pylock.toml",
        "locks/flash-attn.requirements.txt"
      ]
    },
    "finalizer-openvla": {
      "dockerfile": "docker/Dockerfile.finalizer",
      "image": "ovlab-finalizer-openvla:local",
      "sources": [
        "openvla-support"
      ],
      "locks": [
        "locks/finalizer.pylock.toml",
        "locks/finalizer.requirements.txt"
      ]
    }
  },
  "configs": {
    "root": "configs",
    "checkpoints": [
      "registry/default.yaml"
    ],
    "templates": {
      "evaluate": [
        "evaluate/default.yaml"
      ],
      "train": [
        "train/default.yaml"
      ]
    }
  },
  "capabilities": {
    "policy": {
      "supported": true
    },
    "training": {
      "supported": true
    }
  },
  "category": "plugin",
  "providers": {
    "vanilla": {
      "kind": "policy",
      "api_version": "1",
      "config_type": "openvla_vanilla",
      "id": "vanilla",
      "family": "openvla",
      "runtime_status": "implemented",
      "entrypoint": "ovlab_openvla_vanilla.plugin:plugin",
      "sources": [
        "openvla",
        "openvla-support"
      ],
      "source_repositories": [
        "external/openvla"
      ],
      "deployment": {
        "profile": "openvla",
        "role": "policy-openvla",
        "image": "ovlab-policy-openvla:local",
        "image_env": "OVLAB_OPENVLA_IMAGE",
        "policy_service": "policy-openvla",
        "benchmark_service": "benchmark-openvla",
        "quantization": [
          "none",
          "8bit",
          "4bit"
        ],
        "observation_profile": "primary_rgb"
      },
      "capabilities": {
        "observation": {
          "images": {
            "encoding": "raw",
            "color_space": "RGB",
            "dtype": "uint8",
            "roles": [
              "primary"
            ]
          },
          "proprioception": {
            "required": false
          },
          "instruction": {
            "required": true,
            "dynamic": true
          }
        },
        "action": {
          "dimension": 7,
          "representation": "delta_pose",
          "rotation_representation": "axis_angle",
          "gripper_convention": "closed_positive",
          "codecs": [
            "openvla-to-libero-v1"
          ],
          "prediction_horizon": {
            "minimum": 1,
            "maximum": 1,
            "configurable": false
          }
        },
        "inference": {
          "quantization": {
            "none": {
              "backend": null,
              "weight_dtype": "bfloat16",
              "training_supported": true
            },
            "8bit": {
              "backend": "bitsandbytes",
              "format": "llm_int8",
              "bits": 8,
              "compute_dtype": "bfloat16",
              "training_supported": false
            },
            "4bit": {
              "backend": "bitsandbytes",
              "format": "nf4",
              "bits": 4,
              "compute_dtype": "bfloat16",
              "storage_dtype": "float16",
              "double_quantization": true,
              "training_supported": false
            }
          },
          "policy_configs": {
            "none": "plugin://openvla/policy/default.yaml"
          }
        },
        "checkpoints": {
          "expected_loaders": [
            "ovlab-openvla-vanilla"
          ],
          "artifact_forms": [
            "full_weights"
          ],
          "requires_base_model": false
        },
        "training": {
          "supported": true,
          "implementations": [
            "openvla-reference"
          ],
          "methods": [
            "full",
            "lora"
          ],
          "quantization": [
            "none"
          ],
          "status": "implemented"
        }
      },
      "control_sources": [
        "openvla-support"
      ],
      "training": {
        "entrypoint": "ovlab_openvla_training.plugin:plugin",
        "implementations": [
          "openvla-reference"
        ],
        "expected_loaders": [
          "ovlab-openvla-vanilla",
          "ovlab-openvla-peft"
        ],
        "images": {
          "openvla-reference": {
            "role": "training-openvla",
            "image": "ovlab-training-openvla:local",
            "image_env": "OVLAB_TRAINING_IMAGE"
          }
        },
        "modules": {
          "training_runs": "ovlab_openvla_training.training_runs",
          "training_data": "ovlab_openvla_training.training_data",
          "training_evidence": "ovlab_openvla_training.training_evidence",
          "training_quic": "ovlab_openvla_training.training_quic",
          "quic_experiments": "ovlab_openvla_training.quic_experiments",
          "checkpoint_preparation": "ovlab_openvla_training.checkpoint_preparation",
          "workflow_checkpoints": "ovlab_openvla_training.workflow_checkpoints"
        },
        "finalizer": {
          "role": "finalizer-openvla",
          "image": "ovlab-finalizer-openvla:local",
          "image_env": "OVLAB_FINALIZER_IMAGE"
        }
      },
      "preparation": {
        "entrypoint": "ovlab_openvla_training.plugin:preparer",
        "expected_loaders": [
          "ovlab-openvla-peft"
        ],
        "converter_version": "ovlab-dense-inference/v1",
        "image_capability_label": "io.github.ovlab.checkpoint-preparation",
        "image_capability": "lora-merge-v1"
      }
    },
    "lora": {
      "kind": "policy",
      "api_version": "1",
      "config_type": "openvla_lora_merged",
      "id": "lora",
      "family": "lora",
      "runtime_status": "implemented",
      "entrypoint": "ovlab_openvla_lora_merged.plugin:plugin",
      "sources": [
        "openvla",
        "openvla-support"
      ],
      "source_repositories": [
        "external/openvla"
      ],
      "deployment": {
        "profile": "openvla",
        "role": "policy-openvla",
        "image": "ovlab-policy-openvla:local",
        "image_env": "OVLAB_OPENVLA_IMAGE",
        "policy_service": "policy-openvla",
        "benchmark_service": "benchmark-openvla",
        "quantization": [
          "none",
          "8bit",
          "4bit"
        ],
        "observation_profile": "primary_rgb"
      },
      "artifact_forms": [
        "merged_full_weights"
      ],
      "capabilities": {
        "observation": {
          "images": {
            "encoding": "raw",
            "color_space": "RGB",
            "dtype": "uint8",
            "roles": [
              "primary"
            ]
          },
          "proprioception": {
            "required": false
          },
          "instruction": {
            "required": true,
            "dynamic": true
          }
        },
        "action": {
          "dimension": 7,
          "representation": "delta_pose",
          "rotation_representation": "axis_angle",
          "gripper_convention": "closed_positive",
          "codecs": [
            "openvla-to-libero-v1"
          ],
          "prediction_horizon": {
            "minimum": 1,
            "maximum": 1,
            "configurable": false
          }
        },
        "inference": {
          "quantization": {
            "none": {
              "backend": null,
              "weight_dtype": "bfloat16",
              "training_supported": true
            },
            "8bit": {
              "backend": "bitsandbytes",
              "format": "llm_int8",
              "bits": 8,
              "compute_dtype": "bfloat16",
              "training_supported": false
            },
            "4bit": {
              "backend": "bitsandbytes",
              "format": "nf4",
              "bits": 4,
              "compute_dtype": "bfloat16",
              "storage_dtype": "float16",
              "double_quantization": true,
              "training_supported": false
            }
          },
          "policy_configs": {
            "none": "plugin://openvla/policy/lora.yaml"
          }
        },
        "checkpoints": {
          "expected_loaders": [
            "ovlab-openvla-vanilla"
          ],
          "artifact_forms": [
            "merged_full_weights"
          ],
          "requires_base_model": false,
          "adaptation_suite": "LIBERO-10"
        },
        "training": {
          "supported": true,
          "implementations": [
            "openvla-reference"
          ],
          "methods": [
            "full",
            "lora"
          ],
          "quantization": [
            "none"
          ],
          "status": "implemented"
        },
        "checkpoint_binding": {
          "training_methods": [
            "lora"
          ],
          "normalization_key": "libero_10"
        }
      },
      "control_sources": [
        "openvla-support"
      ],
      "training": {
        "entrypoint": "ovlab_openvla_training.plugin:plugin",
        "implementations": [
          "openvla-reference"
        ],
        "expected_loaders": [
          "ovlab-openvla-vanilla",
          "ovlab-openvla-peft"
        ],
        "images": {
          "openvla-reference": {
            "role": "training-openvla",
            "image": "ovlab-training-openvla:local",
            "image_env": "OVLAB_TRAINING_IMAGE"
          }
        },
        "modules": {
          "training_runs": "ovlab_openvla_training.training_runs",
          "training_data": "ovlab_openvla_training.training_data",
          "training_evidence": "ovlab_openvla_training.training_evidence",
          "training_quic": "ovlab_openvla_training.training_quic",
          "quic_experiments": "ovlab_openvla_training.quic_experiments",
          "checkpoint_preparation": "ovlab_openvla_training.checkpoint_preparation",
          "workflow_checkpoints": "ovlab_openvla_training.workflow_checkpoints"
        },
        "finalizer": {
          "role": "finalizer-openvla",
          "image": "ovlab-finalizer-openvla:local",
          "image_env": "OVLAB_FINALIZER_IMAGE"
        }
      },
      "preparation": {
        "entrypoint": "ovlab_openvla_training.plugin:preparer",
        "expected_loaders": [
          "ovlab-openvla-peft"
        ],
        "converter_version": "ovlab-dense-inference/v1",
        "image_capability_label": "io.github.ovlab.checkpoint-preparation",
        "image_capability": "lora-merge-v1"
      }
    }
  }
}
