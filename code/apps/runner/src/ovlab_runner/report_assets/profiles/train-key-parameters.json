        {
          "label": "Maximum optimizer steps",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.max_steps"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.max_steps"
            }
          ]
        },
        {
          "label": "Training seed",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.seed"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.seed"
            }
          ]
        },
        {
          "label": "Output checkpoint",
          "sources": [
            {
              "source": "manifest.json",
              "path": "checkpoint_id"
            }
          ]
        }
      ]
    }
  ]
}
