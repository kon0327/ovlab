        {
          "label": "Dataset",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.profile.dataset.ref"
            }
          ]
        },
        {
          "label": "Dataset ID",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.dataset.dataset_id"
            }
          ]
        },
        {
          "label": "Dataset split",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.profile.dataset.split"
            }
          ]
        }
      ]
    },
    {
      "title": "Batch & supervision",
      "stage": "representation",
      "items": [
        {
          "label": "Batch size per device",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.per_device_batch_size"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.per_device_batch_size"
            }
          ]
        },
        {
          "label": "Gradient accumulation steps",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.gradient_accumulation_steps"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.gradient_accumulation_steps"
            }
          ]
        },
        {
          "label": "Configured precision",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.precision"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.precision"
            }
          ]
        }
      ]
    },
    {
      "title": "Model / policy",
      "stage": "policy",
      "items": [
