      "items": [
        {
          "label": "Training objective",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.trainer_contract.objective"
            },
            {
              "source": "data-flow.json",
              "path": "objective"
            }
          ]
        },
        {
          "label": "Action horizon",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.trainer_contract.action_semantics.horizon"
