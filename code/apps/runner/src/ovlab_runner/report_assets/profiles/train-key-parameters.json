          "label": "Base checkpoint",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.base_checkpoint.resource_id"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.model.base_checkpoint"
            }
          ]
        },
        {
          "label": "Adaptation method",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.peft.method"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.peft.method"
            }
          ]
        },
        {
          "label": "Configured quantization",
          "sources": [
            {
              "source": "training-plan.json",
              "path": "scientific.training.quantization"
            },
            {
              "source": "training-plan.json",
              "path": "scientific.profile.training.quantization"
            }
          ]
        },
        {
          "label": "Total parameters",
          "sources": [
            {
              "source": "result.json",
              "path": "performance.parameter_counts.total"
            },
            {
              "source": "result.json",
              "path": "total_parameter_count"
            }
          ]
        },
        {
          "label": "Trainable parameters",
          "sources": [
            {
              "source": "result.json",
              "path": "performance.parameter_counts.trainable"
            },
            {
              "source": "result.json",
              "path": "trainable_parameter_count"
            }
          ]
        }
      ]
    },
    {
      "title": "Prediction & objective",
