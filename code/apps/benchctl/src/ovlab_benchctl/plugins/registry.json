{
  "schema_version": "ovlab.plugins/v1",
  "sources": {
    "libero": {
      "kind": "git",
      "url": "https://github.com/Lifelong-Robot-Learning/LIBERO.git",
      "commit": "8f1084e3132a39270c3a13ebe37270a43ece2a01",
      "path": "external/libero"
    },
    "openvla": {
      "kind": "git",
      "url": "https://github.com/openvla/openvla.git",
      "commit": "c8f03f48af692657d3060c19588038c7220e9af9",
      "path": "external/openvla"
    },
    "openvla-oft": {
      "kind": "git",
      "url": "https://github.com/moojink/openvla-oft.git",
      "commit": "e4287e94541f459edc4feabc4e181f537cd569a8",
      "path": "external/openvla-oft"
    },
    "openvla-quic": {
      "kind": "git",
      "url": "https://github.com/kon0327/openvla-quic.git",
      "commit": "cca67fab79646363fa98b7d96e6216dcee11fcc6",
      "path": "external/openvla-quic"
    },
    "quic-peft-vla": {
      "kind": "git",
      "url": "https://github.com/kon0327/quic-peft-vla.git",
      "commit": "e727b31c2e4e160c29c0dbe865be093bdd65e5e2",
      "path": "external/quic-peft-vla"
    }
  },
  "plugins": {
    "openvla_vanilla": {
      "config_type": "openvla_vanilla",
      "id": "vanilla",
      "family": "openvla",
      "runtime_status": "implemented",
      "entrypoint": "ovlab_openvla_vanilla.plugin:plugin",
      "sources": [
        "openvla"
      ],
      "source_repositories": [
        "external/openvla"
      ],
      "deployment": {
        "profile": "openvla",
        "role": "policy-openvla",
        "image": "ovlab-policy-openvla:local",
        "image_env": "OVLAB_OPENVLA_IMAGE",
        "policy_service": "policy-openvla",
        "benchmark_service": "benchmark-openvla",
        "quantization": [
          "none",
          "8bit",
          "4bit"
        ],
        "observation_profile": "primary_rgb"
      }
    },
    "openvla_lora_merged": {
      "config_type": "openvla_lora_merged",
      "id": "lora",
      "family": "lora",
      "runtime_status": "implemented",
      "entrypoint": "ovlab_openvla_lora_merged.plugin:plugin",
      "sources": [
        "openvla"
      ],
      "source_repositories": [
        "external/openvla"
      ],
      "deployment": {
        "profile": "openvla",
        "role": "policy-openvla",
        "image": "ovlab-policy-openvla:local",
        "image_env": "OVLAB_OPENVLA_IMAGE",
        "policy_service": "policy-openvla",
        "benchmark_service": "benchmark-openvla",
        "quantization": [
          "none",
          "8bit",
          "4bit"
        ],
        "observation_profile": "primary_rgb"
      },
      "artifact_forms": [
        "merged_full_weights"
      ]
    },
    "openvla_oft": {
      "config_type": "openvla_oft",
      "id": "openvla-oft",
      "family": "openvla_oft",
      "runtime_status": "implemented",
      "entrypoint": "ovlab_openvla_oft.plugin:plugin",
      "sources": [
        "openvla-oft"
      ],
      "source_repositories": [
        "external/openvla-oft"
      ],
      "deployment": {
        "profile": "oft",
        "role": "policy-openvla-oft",
        "image": "ovlab-policy-openvla-oft:local",
        "image_env": "OVLAB_OFT_IMAGE",
        "policy_service": "policy-openvla-oft",
        "benchmark_service": "benchmark-oft",
        "quantization": [
          "none",
          "8bit",
          "4bit"
        ],
        "observation_profile": "native_oft"
      },
      "artifact_forms": [
        "merged_backbone_with_auxiliary_components"
      ]
    },
    "openvla_quic": {
      "config_type": "openvla_quic",
      "id": "quic-peft",
      "family": "openvla_quic",
      "runtime_status": "experimental",
      "entrypoint": "ovlab_openvla_quic.plugin:plugin",
      "sources": [
        "openvla-quic",
        "quic-peft-vla"
      ],
      "source_repositories": [
        "external/openvla-quic",
        "external/quic-peft-vla"
      ],
      "deployment": {
        "profile": "quic",
        "role": "policy-openvla-quic",
        "image": "ovlab-policy-openvla-quic:local",
        "image_env": "OVLAB_QUIC_IMAGE",
        "policy_service": "policy-openvla-quic",
        "benchmark_service": "benchmark-quic",
        "quantization": [
          "none"
        ],
        "observation_profile": "primary_rgb"
      },
      "document_kinds": [
        "quic_policy_descriptor"
      ],
      "supported_quic_profiles": [
        "QP1",
        "QP2",
        "QP3",
        "QP4",
        "custom"
      ],
      "supported_profiles": [
        "QP1",
        "QP2",
        "QP3",
        "QP4",
        "custom"
      ]
    },
    "quic-wc": {
      "config_type": "quic-wc",
      "id": "quic-wc",
      "family": "openvla_quic",
      "runtime_status": "unavailable",
      "entrypoint": null,
      "sources": [],
      "source_repositories": []
    }
  },
  "builds": {
    "benchmark": {
      "dockerfile": "deploy/docker/Dockerfile.benchmark",
      "image": "ovlab-benchmark-libero:local",
      "sources": [
        "libero"
      ],
      "locks": [
        "deploy/locks/benchmark.pylock.toml",
        "deploy/locks/benchmark.requirements.txt"
      ]
    },
    "reporting": {
      "dockerfile": "deploy/docker/Dockerfile.reporting",
      "image": "ovlab-reporting:local",
      "sources": [],
      "locks": [
        "deploy/locks/reporting.pylock.toml",
        "deploy/locks/reporting.requirements.txt"
      ]
    },
    "dataset": {
      "dockerfile": "deploy/docker/Dockerfile.dataset",
      "image": "ovlab-dataset:local",
      "sources": [],
      "locks": [
        "deploy/locks/dataset.pylock.toml",
        "deploy/locks/dataset.requirements.txt"
      ]
    },
    "training-openvla": {
      "dockerfile": "deploy/docker/Dockerfile.training-openvla",
      "image": "ovlab-training-openvla:local",
      "sources": [
        "openvla"
      ],
      "locks": [
        "deploy/locks/openvla-oft.pylock.toml",
        "deploy/locks/openvla-oft.requirements.txt",
        "deploy/locks/training-openvla.pylock.toml",
        "deploy/locks/training-openvla.requirements.txt",
        "deploy/locks/flash-attn.pylock.toml",
        "deploy/locks/flash-attn.requirements.txt"
      ]
    },
    "policy-openvla": {
      "dockerfile": "deploy/docker/Dockerfile.openvla",
      "image": "ovlab-policy-openvla:local",
      "sources": [
        "openvla"
      ],
      "locks": [
        "deploy/locks/openvla.pylock.toml",
        "deploy/locks/openvla.requirements.txt",
        "deploy/locks/flash-attn.pylock.toml",
        "deploy/locks/flash-attn.requirements.txt"
      ]
    },
    "policy-openvla-oft": {
      "dockerfile": "deploy/docker/Dockerfile.openvla-oft",
      "image": "ovlab-policy-openvla-oft:local",
      "sources": [
        "openvla-oft"
      ],
      "locks": [
        "deploy/locks/openvla-oft.pylock.toml",
        "deploy/locks/openvla-oft.requirements.txt",
        "deploy/locks/flash-attn.pylock.toml",
        "deploy/locks/flash-attn.requirements.txt"
      ]
    },
    "policy-openvla-quic": {
      "dockerfile": "deploy/docker/Dockerfile.openvla-quic",
      "image": "ovlab-policy-openvla-quic:local",
      "sources": [
        "openvla-quic",
        "quic-peft-vla"
      ],
      "locks": [
        "deploy/locks/quic-openvla.pylock.toml",
        "deploy/locks/quic-openvla.requirements.txt",
        "deploy/locks/flash-attn.pylock.toml",
        "deploy/locks/flash-attn.requirements.txt"
      ]
    },
    "training-openvla-quic": {
      "dockerfile": "deploy/docker/Dockerfile.training-openvla-quic",
      "image": "ovlab-training-openvla-quic:local",
      "sources": [
        "openvla-quic",
        "quic-peft-vla"
      ],
      "locks": [
        "deploy/locks/quic-openvla.pylock.toml",
        "deploy/locks/quic-openvla.requirements.txt",
        "deploy/locks/flash-attn.pylock.toml",
        "deploy/locks/flash-attn.requirements.txt"
      ]
    }
  }
}
