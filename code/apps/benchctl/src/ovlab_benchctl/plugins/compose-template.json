{
  "services": {
    "@POLICY@": {
      "user": "10001:10001",
      "read_only": true,
      "network_mode": "none",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=0700"
      ],
      "restart": "no",
      "gpus": "all",
      "profiles": [
        "@PROFILE@"
      ],
      "image": "${OVLAB_POLICY_IMAGE:-@IMAGE@}",
      "command": [
        "service",
        "serve",
        "${OVLAB_EXPERIMENT_CONFIG:?experiment required}",
        "--socket",
        "/run/ovlab/policy.sock"
      ],
      "environment": {
        "OVLAB_PROGRESS": "${OVLAB_PROGRESS:-auto}",
        "OVLAB_DEPLOYMENT_PROFILE": "@PROFILE@",
        "OVLAB_EXECUTION_PROFILE": "${OVLAB_EXECUTION_PROFILE:?execution profile required}",
        "OVLAB_CONFIG_BUNDLE_SHA256": "${OVLAB_CONFIG_BUNDLE_SHA256:?config identity required}",
        "OVLAB_PLUGIN_REGISTRY": "/opt/ovlab/configs/plugins/registry.json",
        "OVLAB_RESOLVED_CHECKPOINT_ID": "${OVLAB_RESOLVED_CHECKPOINT_ID}",
        "OVLAB_RESOLVED_CHECKPOINT_CONTAINER_PATH": "/checkpoints/resolved/${OVLAB_RESOLVED_CHECKPOINT_ID}",
        "OVLAB_CHECKPOINT_SOURCE_KIND": "${OVLAB_CHECKPOINT_SOURCE_KIND}",
        "OVLAB_CHECKPOINT_REPOSITORY": "${OVLAB_CHECKPOINT_REPOSITORY}",
        "OVLAB_CHECKPOINT_REVISION": "${OVLAB_CHECKPOINT_REVISION}",
        "OVLAB_CHECKPOINT_SHA256": "${OVLAB_CHECKPOINT_SHA256}",
        "OVLAB_DEPLOYMENT_MANIFEST_SHA256": "${OVLAB_DEPLOYMENT_MANIFEST_SHA256:-unavailable}",
        "OVLAB_CONTAINER_RUNTIME_VERSION": "${OVLAB_CONTAINER_RUNTIME_VERSION:-unavailable}",
        "OVLAB_SERVICE_TOPOLOGY": "@BENCHMARK@--af-unix--@POLICY@",
        "NVIDIA_VISIBLE_DEVICES": "${OVLAB_GPU_DEVICE:-all}",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "HF_HOME": "/tmp/ovlab-huggingface",
        "HF_HUB_CACHE": "/tmp/ovlab-huggingface/hub",
        "HF_MODULES_CACHE": "/tmp/ovlab-transformers-modules",
        "OVLAB_IMAGE_DIGEST": "${OVLAB_POLICY_IMAGE_DIGEST:-unavailable}",
        "OVLAB_OFFLINE_MODE": "hf-hub-offline,transformers-offline,network-none",
        "OVLAB_MOUNT_CONTRACT": "config-bundle-ro,resolved-checkpoint-ro,rpc-rw",
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
        "OVLAB_LOCAL_PROFILE": "/opt/ovlab/configs/plugins/runtime-profile.yaml"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${OVLAB_CONFIG_BUNDLE_PATH:?config bundle required}",
          "target": "/opt/ovlab/configs",
          "read_only": true
        },
        "rpc-policy:/run/ovlab",
        {
          "type": "bind",
          "source": "${OVLAB_RESOLVED_CHECKPOINT_PATH:?checkpoint required}",
          "target": "/checkpoints/resolved/${OVLAB_RESOLVED_CHECKPOINT_ID}",
          "read_only": true
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "ovlab",
          "service",
          "health",
          "--socket",
          "/run/ovlab/policy.sock",
          "--json"
        ],
        "interval": "10s",
        "timeout": "8s",
        "retries": 6,
        "start_period": "15m"
      }
    },
    "@BENCHMARK@": {
      "user": "10001:10001",
      "read_only": true,
      "network_mode": "none",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m,uid=10001,gid=10001,mode=0700"
      ],
      "restart": "no",
      "gpus": "all",
      "profiles": [
        "@PROFILE@"
      ],
      "stop_grace_period": "5m",
      "image": "${OVLAB_BENCHMARK_IMAGE:-ovlab-benchmark-libero:local}",
      "command": [
        "_native-run",
        "${OVLAB_EXPERIMENT_CONFIG:?experiment required}",
        "--output-root",
        "${OVLAB_EVALUATION_OUTPUT_ROOT:-/var/lib/ovlab/runs/evaluate}"
      ],
      "environment": {
        "OVLAB_PROGRESS": "${OVLAB_PROGRESS:-auto}",
        "OVLAB_DEPLOYMENT_PROFILE": "@PROFILE@",
        "OVLAB_EXECUTION_PROFILE": "${OVLAB_EXECUTION_PROFILE:?execution profile required}",
        "OVLAB_CONFIG_BUNDLE_SHA256": "${OVLAB_CONFIG_BUNDLE_SHA256:?config identity required}",
        "OVLAB_PLUGIN_REGISTRY": "/opt/ovlab/configs/plugins/registry.json",
        "OVLAB_RESOLVED_CHECKPOINT_ID": "${OVLAB_RESOLVED_CHECKPOINT_ID}",
        "OVLAB_RESOLVED_CHECKPOINT_CONTAINER_PATH": "/checkpoints/resolved/${OVLAB_RESOLVED_CHECKPOINT_ID}",
        "OVLAB_CHECKPOINT_SOURCE_KIND": "${OVLAB_CHECKPOINT_SOURCE_KIND}",
        "OVLAB_CHECKPOINT_REPOSITORY": "${OVLAB_CHECKPOINT_REPOSITORY}",
        "OVLAB_CHECKPOINT_REVISION": "${OVLAB_CHECKPOINT_REVISION}",
        "OVLAB_CHECKPOINT_SHA256": "${OVLAB_CHECKPOINT_SHA256}",
        "OVLAB_DEPLOYMENT_MANIFEST_SHA256": "${OVLAB_DEPLOYMENT_MANIFEST_SHA256:-unavailable}",
        "OVLAB_CONTAINER_RUNTIME_VERSION": "${OVLAB_CONTAINER_RUNTIME_VERSION:-unavailable}",
        "OVLAB_SERVICE_TOPOLOGY": "@BENCHMARK@--af-unix--@POLICY@",
        "NVIDIA_VISIBLE_DEVICES": "${OVLAB_GPU_DEVICE:-all}",
        "MUJOCO_GL": "egl",
        "MUJOCO_EGL_DEVICE_ID": "${OVLAB_EGL_DEVICE_ID:-0}",
        "OVLAB_IMAGE_DIGEST": "${OVLAB_BENCHMARK_IMAGE_DIGEST:-unavailable}",
        "OVLAB_OFFLINE_MODE": "network-none",
        "OVLAB_MOUNT_CONTRACT": "config-bundle-ro,datasets-ro,runs-rw,rpc-rw",
        "OVLAB_ARTIFACT_UMASK": "0007",
        "OVLAB_POSTPROCESSING_MODE": "external",
        "OVLAB_CHECKPOINT_ID": "${OVLAB_RESOLVED_CHECKPOINT_ID}",
        "OVLAB_CHECKPOINT_HOST_PATH": "${OVLAB_RESOLVED_CHECKPOINT_PATH}",
        "NVIDIA_DRIVER_CAPABILITIES": "compute,graphics,utility",
        "OVLAB_EXPERIMENT_ID": "${OVLAB_EXPERIMENT_ID:-}",
        "OVLAB_EXPERIMENT_NODE": "${OVLAB_EXPERIMENT_NODE:-}",
        "OVLAB_LOCAL_PROFILE": "/opt/ovlab/configs/plugins/runtime-profile.yaml"
      },
      "group_add": [
        "${OVLAB_HOST_ARTIFACT_GID:-1000}"
      ],
      "depends_on": {
        "@POLICY@": {
          "condition": "service_healthy",
          "restart": false
        }
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${OVLAB_CONFIG_BUNDLE_PATH:?config bundle required}",
          "target": "/opt/ovlab/configs",
          "read_only": true
        },
        "rpc-policy:/run/ovlab",
        {
          "type": "bind",
          "source": "${OVLAB_DATASETS_PATH:?datasets required}",
          "target": "/datasets",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "${OVLAB_RUNS_ROOT:-../../../ovlab-data/runs}",
          "target": "/var/lib/ovlab/runs",
          "read_only": false
        }
      ]
    }
  },
  "volumes": {
    "rpc-policy": {}
  }
}
